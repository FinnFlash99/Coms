# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenChannels API (backend for conversations/messages)
VITE_OPENCHANNELS_URL=http://localhost:8787

# Database (D1)
# These are auto-configured by wrangler

# OAuth Credentials (set via wrangler secret)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_VERIFICATION_TOKEN=

# WhatsApp/Meta Business (set via wrangler secret)
# META_APP_ID=
# META_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# Encryption Key (32-byte hex string, set via wrangler secret)
# ENCRYPTION_KEY=

{
  "name": "coms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "wrangler d1 migrations create coms-db",
    "db:migrate:local": "wrangler d1 migrations apply coms-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply coms-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@sveltejs/adapter-cloudflare": "^4.8.0",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/eslint": "^9.6.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "lucide-svelte": "^0.469.0"
  }
}
